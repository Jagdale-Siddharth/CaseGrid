# Copy this file to .env and fill in your own values:  copy .env.example .env
# NEVER commit the real .env file.

# --- Database ---
# Default: SQLite (no setup needed)
DATABASE_URL=sqlite:///./aicte.db
# PostgreSQL alternative:
# DATABASE_URL=postgresql+psycopg2://aicte:aicte@localhost:5432/aicte_complaints

# --- Security ---
SECRET_KEY=replace-with-a-long-random-string
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Demo clock (keeps ageing maths stable; remove to use the real date) ---
FIXED_TODAY=2026-10-23
ENABLE_SCHEDULER=false

# --- Multilingual (English / Hindi / Marathi) meaning-based matching ---
# Small local model (~220 MB), downloaded once into MODEL_CACHE_DIR.
# If unavailable, the app falls back to basic matching.
SEMANTIC_ENABLED=true

# --- Email OTP for the mobile app (works for ANY recipient email) ---
# Gmail setup: turn on 2-Step Verification, then create an App Password at
# https://myaccount.google.com/apppasswords  (paste it below without spaces)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-account@gmail.com
SMTP_PASSWORD=your-16-char-app-password
SMTP_FROM_EMAIL=your-account@gmail.com

# Optional alternative: Resend (only sends to any address after you verify your own domain)
RESEND_API_KEY=
RESEND_FROM_EMAIL=AICTE Grievance Portal <noreply@your-verified-domain.com>

# Dev only: show the OTP in the app if email sending fails
OTP_DEBUG_FALLBACK=false